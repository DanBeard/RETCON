# MicroRETCON device config template (M1)

# The SAME file format the Pi writes. The device's crns parser owns
# [reticulum] + [interfaces] exactly as on the Pi; the [micro] section is
# board-side settings the firmware consumes and the Pi's tooling ignores
# (crns M1, host/config.hpp MicroConfig). Copy this file between a Pi and
# an ESP32 and everything in [[[rnode]]] keeps its meaning.

[retcon]

  name = Micro Node

  # transport = forwards traffic, no UI
  # client    = the USB cable IS the console (captive browser UI)
  mode = client

  [[wifi]]
    # mesh_mode = tcp on an ESP32 means the ESP32 is a station joining
    # APs and optionally hosting a SoftAP (lwIP, not NetworkManager).
    # Same keys, different plumbing — the SSID-prefix scan is the same
    # algorithm as the Pi's.
    host_ap = false
    prefix = "RT-DEFAULT-"
    psk = "retcon123"
    mesh_mode = tcp
    client_iface = 'wlan0'
    ap_iface = 'uap0'

# Board-side settings — firmware consumes these directly. On the Pi this
# section is parsed and ignored (MicroRETCON DESIGN §3).
[micro]

  # which [[interfaces]] section is the ON-BOARD SX1262 (driven over SPI,
  # not a serial RNode). The section still uses rnode keys so the same
  # values survive a config copy between Pi and ESP32.
  lora_iface = rnode0

  # ESP-NOW bearer. Shared-channel rule: if the device is also a WiFi
  # STA/AP, the AP's channel WINS and ESP-NOW follows it. Standalone mesh
  # nodes use this channel.
  espnow_channel = 6

  # USB posture (DESIGN §5):
  #   transport = CDC-serial is a Reticulum interface (HDLC framing) — a
  #               laptop becomes a mesh peer over USB. MSC drive still pops.
  #   gadget    = NCM/RNDIS ethernet + captive portal ("the cable is the
  #               console"). CDC console still available.
  #   serial    = plain CDC console only.
  usb_mode = gadget

[interfaces]

  # The on-board SX1262. rnode keys (so the values match a Pi-side
  # usb_autodetect [[rnode]] block verbatim).
  #
  # Two postures of this one section, resolved by the device firmware
  # (not the parser): on the ESP32, [micro] lora_iface = rnode0 means
  # "drive the SX1262 over SPI with these radio params" — the port key
  # is meaningless there. On the PI, this same section is a serial
  # RNode: set port = /dev/ttyACM0 (or let usb_autodetect find it).
  #
  # The parser requires port on every ENABLED RNodeInterface (serial
  # device path), so the template ships disabled — flip enabled when
  # adopting on either end. The firmware treats lora_iface entries as
  # its own radio regardless of the enabled flag (M2 wiring).
  [[rnode0]]
    type = RNodeInterface
    enabled = no
    # port = /dev/ttyACM0      # Pi-side serial RNode only
    frequency = 914875000
    bandwidth = 125000
    txpower = 14
    spreadingfactor = 8
    codingrate = 5